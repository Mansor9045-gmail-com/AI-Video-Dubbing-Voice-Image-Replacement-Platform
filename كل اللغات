items=[]
for code,name,rtl in langs:
    items.append({
        "code":code, "name":name, "direction":"rtl" if rtl else "ltr",
        "stt": True, "translation": True, "tts": True, "subtitles": True,
        "status":"provider_dependent"
    })

root=Path("/mnt/data/AI-Video-Dubbing-Language-Library")
if root.exists(): shutil.rmtree(root)
(root/"languages").mkdir(parents=True)

(root/"languages/languages.json").write_text(
    json.dumps(items,ensure_ascii=False,indent=2),encoding="utf-8"
)

(root/"languages/README.md").write_text("""# Language Library

Contains a centralized language catalog for the AI video dubbing platform.

Fields:
- `code`: language identifier used by the application
- `name`: display name
- `direction`: `ltr` or `rtl`
- `stt`: speech-to-text availability flag
- `translation`: translation availability flag
- `tts`: text-to-speech availability flag
- `subtitles`: subtitle support flag
- `status`: actual provider support must be verified for the selected STT/translation/TTS providers

Important: support is provider-dependent. Do not promise every language to users unless the configured providers actually support it.
""",encoding="utf-8")

(root/"languages/language_codes.py").write_text("""import json
from pathlib import Path

DATA = Path(__file__).with_name("languages.json")
LANGUAGES = json.loads(DATA.read_text(encoding="utf-8"))
LANGUAGE_BY_CODE = {x["code"]: x for x in LANGUAGES}

def get_languages():
    return LANGUAGES

def get_language(code: str):
    return LANGUAGE_BY_CODE.get(code)
""",encoding="utf-8")

(root/"backend_language_api.py").write_text("""from pathlib import Path
import json

LANG_FILE = Path(__file__).parent / "languages" / "languages.json"
LANGUAGES = json.loads(LANG_FILE.read_text(encoding="utf-8"))

def list_languages():
    return LANGUAGES

def find_language(code: str):
    return next((x for x in LANGUAGES if x["code"] == code), None)
""",encoding="utf-8")

zip_path=Path("/mnt/data/AI-Video-Dubbing-Language-Library.zip")
with zipfile.ZipFile(zip_path,"w",zipfile.ZIP_DEFLATED) as z:
    for p in root.rglob("*"):
        if p.is_file(): z.write(p,p.relative_to(root))

