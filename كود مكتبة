import pyttsx3

# تشغيل المحرك الصوتى
engine = pyttsx3.init()

# ضبط سرعة الكلام (اختياري)
engine.setProperty('rate', 150) 

# النص المراد نطقة
text = "أهلاً بك، هذا تعليق صوتي يعمل بدون الحاجة للاتصال بالإنترنت."

# أمر القراءة المباشرة
engine.say(text)

# تنفيذ الأمر وتشغيل الصوت
engine.runAndWait()

