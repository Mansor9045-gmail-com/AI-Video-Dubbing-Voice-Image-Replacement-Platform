"backend/app/main.py":"""import os, shutil, subprocess, json
from pathlib import Path
from uuid import uuid4
from fastapi import FastAPI, UploadFile, File, HTTPException, BackgroundTasks
from fastapi.middleware.cors import CORSMiddleware

BASE=Path("/app/storage"); BASE.mkdir(parents=True,exist_ok=True)
app=FastAPI(title="AI Video Dubbing PRO",version="1.0")
app.add_middleware(CORSMiddleware,allow_origins=["*"],allow_credentials=True,allow_methods=["*"],allow_headers=["*"])

@app.get("/")
def root(): return {"service":"AI Video Dubbing PRO","status":"online"}

@app.get("/health")
def health(): return {"status":"ok"}

@app.post("/api/projects")
def create_project(name:str="مشروع جديد"):
    pid=str(uuid4()); d=BASE/pid; d.mkdir()
    (d/"project.json").write_text(json.dumps({"id":pid,"name":name,"status":"created"},ensure_ascii=False))
    return {"id":pid,"name":name,"status":"created"}

@app.post("/api/projects/{pid}/upload")
async def upload(pid:str,file:UploadFile=File(...)):
    d=BASE/pid
    if not d.exists(): raise HTTPException(404,"المشروع غير موجود")
    if not file.filename: raise HTTPException(400,"ملف غير صالح")
    target=d/"source.mp4"
    with target.open("wb") as f: shutil.copyfileobj(file.file,f)
    return {"project_id":pid,"file":str(target),"status":"uploaded"}

def run_cmd(cmd):
    p=subprocess.run(cmd,capture_output=True,text=True)
    if p.returncode: raise RuntimeError(p.stderr[-2000:])
    return p.stdout

@app.post("/api/projects/{pid}/extract-audio")
def extract_audio(pid:str):
    d=BASE/pid; src=d/"source.mp4"; out=d/"audio.wav"
    if not src.exists(): raise HTTPException(404,"ارفع الفيديو أولاً")
    run_cmd(["ffmpeg","-y","-i",str(src),"-vn","-ac","1","-ar","16000","-c:a","pcm_s16le",str(out)])
    return {"status":"audio_ready","path":f"/storage/{pid}/audio.wav"}

@app.post("/api/projects/{pid}/process")
def process(pid:str,background_tasks:BackgroundTasks,source_language:str="auto",target_language:str="ar"):
    d=BASE/pid
    if not (d/"source.mp4").exists(): raise HTTPException(404,"ارفع الفيديو أولاً")
    (d/"job.json").write_text(json.dumps({"status":"queued","source_language":source_language,"target_language":target_language},ensure_ascii=False))
    # Hook for production workers: STT -> translation -> TTS -> sync -> render.
    return {"project_id":pid,"status":"queued","steps":["STT","translation","TTS","sync","subtitles","render"]}

@app.get("/api/projects/{pid}/status")
def status(pid:str):
    d=BASE/pid
    if not d.exists(): raise HTTPException(404,"المشروع غير موجود")
    job=d/"job.json"
    return json.loads(job.read_text()) if job.exists() else {"status":"created"}
