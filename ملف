"backend/app/main.py": """from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from pathlib import Path
from uuid import uuid4
import shutil

BASE = Path("/app/storage")
BASE.mkdir(parents=True, exist_ok=True)

app = FastAPI(title="AI Video Dubbing Platform", version="0.1.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.mount("/storage", StaticFiles(directory=BASE), name="storage")

@app.get("/")
def root():
    return {"name": "AI Video Dubbing Platform", "status": "running"}

@app.get("/health")
def health():
    return {"status": "ok"}

@app.post("/api/projects")
def create_project(name: str = "مشروع جديد"):
    project_id = str(uuid4())
    (BASE / project_id).mkdir(parents=True, exist_ok=True)
    return {"id": project_id, "name": name, "status": "created"}

@app.post("/api/projects/{project_id}/upload")
async def upload_video(project_id: str, file: UploadFile = File(...)):
    project_dir = BASE / project_id
    if not project_dir.exists():
        raise HTTPException(404, "المشروع غير موجود")
    if not file.filename:
        raise HTTPException(400, "الملف غير صالح")
    target = project_dir / "source.mp4"
    with target.open("wb") as out:
        shutil.copyfileobj(file.file, out)
    return {
        "project_id": project_id,
        "filename": file.filename,
        "path": f"/storage/{project_id}/source.mp4",
        "next": "transcription"
    }

@app.post("/api/projects/{project_id}/process")
def process_project(project_id: str, source_language: str = "auto", target_language: str = "ar"):
    if not (BASE / project_id).exists():
        raise HTTPException(404, "المشروع غير موجود")
    # Pipeline hook: FFmpeg -> Whisper -> translation -> TTS -> mixing -> MP4.
    return {
        "project_id": project_id,
        "status": "queued",
        "source_language": source_language,
        "target_language": target_language,
        "pipeline": [
            "extract_audio",
            "speech_to_text",
            "speaker_timestamps",
            "translate",
            "create_srt",
            "text_to_speech",
            "sync_voice",
            "mix_audio",
            "render_mp4"
        ]
    }
""",
